        {
          "kind": "message",
          "input": "I would like something warm, savory and chewy.",
          "expect": {
            "dialogue_act": "HOLD_RECOMMENDATION",
            "readiness": "HELD",
            "card_count": 0,
            "snapshot": "absent",
            "state": {
              "equals": {
                "recommendation_hold": true
              },
              "contains": {
                "temperature_preferences": ["warm"],
                "texture_preferences": ["chewy"],
                "flavor_preferences": ["savory"],
                "excluded_categories": ["soup"],
                "excluded_ingredients": ["pork"]
              }
            }
          }
        },
        {
          "kind": "message",
          "input": "Recommend something mild under 12,000 won now.",
          "expect": {
            "dialogue_act": "RECOMMEND",
            "readiness": "EXPLICIT_REQUEST",
            "card_types": ["menu_recommendations"],
            "snapshot": "present",
            "state": {
              "equals": {
                "recommendation_hold": false,
                "budget_krw": 12000,
                "max_spiciness": 1
              },
              "contains": {
                "excluded_categories": ["soup"],
                "excluded_ingredients": ["pork"]
              }
            },
            "menus": {
              "minimum_count": 1,
              "maximum_price": 12000,
              "maximum_spiciness": 1,
              "forbidden_category_groups": ["soup"],
              "all_synthetic": true
            }
          }
        }
      ]
