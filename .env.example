# Runtime mode. Keep real values only in /etc/yobi/yobi.env on the VM.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
DEMO_MODE=true
DEMO_FALLBACK_ENABLED=true
DEMO_DB_BACKEND=sqlite

# OCI Generative AI. Never expose these values to the frontend.
OCI_GENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/20231130/actions/v1
OCI_GENAI_REGION=us-chicago-1
OCI_GENAI_API_KEY=
OCI_GENAI_MODEL=xai.grok-4.3
OCI_GENAI_FALLBACK_MODEL=openai.gpt-oss-120b
# One-dispatch model selects three grounded menus from the server shortlist and explains them.
STRUCTURED_RECOMMENDATION_MODEL=xai.grok-4.3
STRUCTURED_RECOMMENDATION_MAX_OUTPUT_TOKENS=4096
STRUCTURED_RECOMMENDATION_MAX_CONCURRENT_REQUESTS=2
RECOMMENDATION_CANDIDATE_LIMIT=100
RECOMMENDATION_LLM_SHORTLIST_LIMIT=15
RECOMMENDATION_LLM_SELECTION_ENABLED=true
GENAI_PROVIDER=oci
OCI_GENAI_SERVING_MODE=on_demand
OCI_GENAI_ENDPOINT_ID=
OCI_GENAI_FALLBACK_ENDPOINT_ID=
OCI_GENAI_STRUCTURED_OUTPUT_ENABLED=false
OCI_GENAI_STREAMING_ENABLED=false
# Provider/endpoint capability profile. Set these to the verified request envelope.
OCI_GENAI_MAX_INPUT_TOKENS=131072
OCI_GENAI_MAX_OUTPUT_TOKENS=4096
OCI_GENAI_MAX_TOOLS_PER_REQUEST=4
OCI_GENAI_MAX_TOOL_CALLS_PER_RESPONSE=4
OCI_EMBED_MODEL=cohere.embed-v4.0
OCI_EMBED_DIMENSION=1536
# Keep seed and query vectors on one explicit provider. Use auto only for a one-off smoke test.
EMBEDDING_PROVIDER=deterministic
OCI_COMPARTMENT_ID=

# Oracle AI Database 26ai. ADMIN is not a runtime account.
ADB_DSN=
DB_USERNAME=YOBI_APP
DB_PASSWORD=

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=0
LLM_MAX_INPUT_TOKENS=131072
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_TOOLS_PER_REQUEST=4
LLM_MAX_TOOL_CALLS_PER_RESPONSE=4
TOOL_CALL_MAX_STEPS=6
MAX_UPLOAD_MB=8
ADDRESS_OCR_PROVIDER=tesseract
LOG_LEVEL=INFO
DEMO_CONTROL_TOKEN=
