# Runtime mode. Keep real values only in /etc/yobi/yobi.env on the VM.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:5173
DEMO_MODE=true
DEMO_FALLBACK_ENABLED=true
DEMO_DB_BACKEND=sqlite

# OCI Generative AI. Never expose these values to the frontend.
OCI_GENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/20231130/actions/v1
OCI_GENAI_API_KEY=
OCI_GENAI_MODEL=xai.grok-4.3
OCI_GENAI_FALLBACK_MODEL=openai.gpt-oss-120b
OCI_EMBED_MODEL=cohere.embed-v4.0
OCI_EMBED_DIMENSION=1536
OCI_COMPARTMENT_ID=

# Oracle AI Database 26ai. ADMIN is not a runtime account.
ADB_DSN=
DB_USERNAME=YOBI_APP
DB_PASSWORD=

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=0
TOOL_CALL_MAX_STEPS=6
MAX_UPLOAD_MB=8
ADDRESS_OCR_PROVIDER=tesseract
LOG_LEVEL=INFO
DEMO_CONTROL_TOKEN=
